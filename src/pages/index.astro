---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';
import CharacterCard from '../components/CharacterCard.astro';
import AdSlot from '../components/AdSlot.astro';
import characters from '../data/characters.json';
import anime from '../data/anime.json';
import lists from '../data/lists.json';
import blogPosts from '../data/blog-posts.json';
import quizzes from '../data/quizzes.json';

// Sort and pick featured data
const featuredCharacters = characters
  .sort((a, b) => b.popularity - a.popularity)
  .slice(0, 8);

const popularAnime = anime.slice(0, 6);
const topLists = lists.slice(0, 4);
const recentBlogs = blogPosts.slice(0, 3);
const activeQuizzes = quizzes;

// Query characters for the hero collage
const collageSlugs = ['goku', 'naruto-uzumaki', 'monkey-d-luffy', 'gojo-satoru', 'nezuko-kamado', 'sasuke-uchiha'];
const collageCharacters = collageSlugs.map(slug => characters.find(c => c.slug === slug)).filter(Boolean);
---

<Layout
  title="AnimeCharactersList — Ultimate Anime Character Database & Rankings"
  description="Explore detailed profiles, stats, abilities, and transformations of 100+ anime characters. Take personality quizzes, compare matchups, and browse top rankings."
  schemaType="WebSite"
>
  <!-- Upgraded Hero Section -->
  <section class="relative overflow-hidden py-20 px-4 md:py-28 bg-gradient-hero border-b border-border-default">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-accent-blue/10 via-transparent to-transparent pointer-events-none"></div>
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-7 gap-12 items-center relative z-10">
      
      <!-- Headline & Search (Left 4 columns) -->
      <div class="lg:col-span-4 space-y-6 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-bg-secondary border border-border-default text-xs font-semibold text-accent-blue shadow-glow-blue select-none">
          <span class="w-2 h-2 rounded-full bg-accent-blue animate-pulse"></span>
          Now indexing 100+ Characters & 10 Anime Series
        </div>
        
        <h1 class="text-text-primary text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight relative">
          <!-- Glow behind headline -->
          <span class="absolute -left-6 -top-6 -right-6 bottom-0 bg-[radial-gradient(circle,_rgba(88,166,255,0.12)_0%,_transparent_60%)] filter blur-2xl pointer-events-none"></span>
          Find Your Favorite <br class="hidden sm:inline" />
          <span class="gradient-text font-black">Anime Characters</span>
        </h1>
        
        <p class="text-text-secondary text-sm md:text-base max-w-xl leading-relaxed">
          Analyze power levels, study character transformations, compare legendary matchups, and take interactive personality quizzes.
        </p>

        <!-- Live Search Bar -->
        <div class="pt-2 max-w-lg">
          <SearchBar />
        </div>
      </div>

      <!-- Character Collage (Right 3 columns) -->
      <div class="lg:col-span-3 relative h-[380px] w-full hidden lg:block overflow-visible select-none">
        <div class="absolute inset-0 bg-[radial-gradient(circle,_var(--color-accent-blue)/0.15_0%,_transparent_65%)] filter blur-3xl pointer-events-none"></div>
        {collageCharacters.length >= 6 && (
          <>
            <!-- 1. Goku -->
            <div class="absolute top-[0px] left-[0px] w-32 h-44 rounded-xl overflow-hidden border border-border-default rotate-[-10deg] shadow-card hover:scale-110 hover:rotate-0 hover:z-30 hover:border-accent-blue hover:shadow-glow-blue transition-all duration-300">
              <img src={collageCharacters[0].image} alt="" class="w-full h-full object-cover" loading="eager" />
            </div>
            <!-- 2. Naruto -->
            <div class="absolute top-[40px] left-[110px] w-32 h-44 rounded-xl overflow-hidden border border-border-default rotate-[4deg] shadow-card hover:scale-110 hover:rotate-0 hover:z-30 hover:border-accent-blue hover:shadow-glow-blue transition-all duration-300">
              <img src={collageCharacters[1].image} alt="" class="w-full h-full object-cover" loading="eager" />
            </div>
            <!-- 3. Luffy -->
            <div class="absolute top-[0px] right-[10px] w-32 h-44 rounded-xl overflow-hidden border border-border-default rotate-[-6deg] shadow-card hover:scale-110 hover:rotate-0 hover:z-30 hover:border-accent-blue hover:shadow-glow-blue transition-all duration-300">
              <img src={collageCharacters[2].image} alt="" class="w-full h-full object-cover" loading="eager" />
            </div>
            <!-- 4. Gojo -->
            <div class="absolute bottom-[20px] left-[20px] w-32 h-44 rounded-xl overflow-hidden border border-border-default rotate-[8deg] shadow-card hover:scale-110 hover:rotate-0 hover:z-30 hover:border-accent-blue hover:shadow-glow-blue transition-all duration-300">
              <img src={collageCharacters[3].image} alt="" class="w-full h-full object-cover" loading="eager" />
            </div>
            <!-- 5. Nezuko -->
            <div class="absolute bottom-[40px] right-[100px] w-32 h-44 rounded-xl overflow-hidden border border-border-default rotate-[-8deg] shadow-card hover:scale-110 hover:rotate-0 hover:z-30 hover:border-accent-blue hover:shadow-glow-blue transition-all duration-300">
              <img src={collageCharacters[4].image} alt="" class="w-full h-full object-cover" loading="eager" />
            </div>
            <!-- 6. Sasuke -->
            <div class="absolute bottom-[10px] right-[0px] w-32 h-44 rounded-xl overflow-hidden border border-border-default rotate-[12deg] shadow-card hover:scale-110 hover:rotate-0 hover:z-30 hover:border-accent-blue hover:shadow-glow-blue transition-all duration-300">
              <img src={collageCharacters[5].image} alt="" class="w-full h-full object-cover" loading="eager" />
            </div>
          </>
        )}
      </div>

    </div>
  </section>

  <!-- Google Ad Slot -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
    <AdSlot slot="homepage-hero-bottom" format="banner" />
  </div>

  <!-- Featured Characters Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="section-title">Popular Characters</h2>
        <p class="text-text-secondary text-sm">Most searched characters in our directory</p>
      </div>
      <a href="/characters" class="btn btn-secondary px-4 py-2 text-xs rounded-lg hover:border-accent-blue transition-all">
        View All 100+
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
      {featuredCharacters.map(char => (
        <CharacterCard character={char} />
      ))}
    </div>
  </section>

  <!-- Upgraded Netflix-Style snap scroll row -->
  <section class="bg-bg-secondary border-y border-border-default py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8">
        <div>
          <h2 class="section-title">Featured Anime Series</h2>
          <p class="text-text-secondary text-sm">Explore characters grouped by their franchise</p>
        </div>
        <a href="/anime" class="btn btn-secondary px-4 py-2 text-xs rounded-lg hover:border-accent-blue transition-all">
          All Series
        </a>
      </div>

      <!-- Horizontal Scrollable Snap Row -->
      <div class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-6 scrollbar-none scroll-container">
        {popularAnime.map(a => (
          <div class="card snap-start flex-shrink-0 w-[240px] bg-bg-primary hover:border-accent-orange hover:shadow-card-hover transition-all duration-300 flex flex-col group">
            
            <!-- Netflix aspect ratio poster (2:3) -->
            <div class="aspect-[2/3] w-full overflow-hidden bg-bg-secondary relative border-b border-border-default">
              <img
                src={a.image}
                alt={a.title}
                width="400"
                height="600"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute top-3 right-3 bg-bg-secondary/90 backdrop-blur-sm border border-border-default rounded-lg px-2 py-0.5 text-[10px] font-bold text-accent-yellow flex items-center gap-0.5">
                ★ {a.rating.toFixed(1)}
              </div>
            </div>
            
            <div class="p-4 flex-grow flex flex-col justify-between">
              <div>
                <h3 class="font-heading font-bold text-sm text-text-primary truncate group-hover:text-accent-orange transition-colors">
                  <a href={`/anime/${a.slug}`}>{a.title}</a>
                </h3>
                <span class="text-[10px] text-text-tertiary font-semibold">{a.studio} • {a.episodes} eps</span>
              </div>
              <a href={`/anime/${a.slug}`} class="text-[10px] text-accent-orange font-bold uppercase tracking-wider mt-3 block hover:underline">
                Explore Cast &rarr;
              </a>
            </div>
            
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mid Page Ad Slot -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
    <AdSlot slot="homepage-mid" format="banner" />
  </div>

  <!-- Interactive Modules: Quizzes & Comparisons -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Quizzes column -->
      <div class="space-y-6">
        <div>
          <h2 class="section-title">Personality & Trivia Quizzes</h2>
          <p class="text-text-secondary text-sm">Discover your anime counterpart and test your lore knowledge</p>
        </div>
        
        <div class="space-y-4">
          {activeQuizzes.map(quiz => (
            <div class="card p-5 bg-bg-secondary hover:border-accent-pink flex gap-4 items-center transition-all duration-300">
              <div class="w-16 h-16 rounded-xl overflow-hidden flex-shrink-0 bg-bg-primary border border-border-default">
                <img src={quiz.image} alt={quiz.title} class="w-full h-full object-cover" loading="lazy" />
              </div>
              <div class="flex-grow">
                <h3 class="font-heading font-bold text-base text-text-primary hover:text-accent-pink transition-colors">
                  <a href={`/quiz/${quiz.slug}`}>{quiz.title}</a>
                </h3>
                <p class="text-xs text-text-secondary line-clamp-1">{quiz.description}</p>
                <div class="flex items-center gap-3 mt-1 text-[10px] text-text-tertiary font-bold uppercase tracking-wider">
                  <span>{quiz.questions.length} Questions</span>
                  <span>•</span>
                  <a href={`/quiz/${quiz.slug}`} class="text-accent-pink hover:underline">Start Quiz &rarr;</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Matchup Comparisons column -->
      <div class="space-y-6">
        <div>
          <h2 class="section-title">Character Matchups</h2>
          <p class="text-text-secondary text-sm">Detailed combat reports and stat comparisons</p>
        </div>
        
        <div class="card p-6 bg-gradient-to-br from-bg-secondary to-bg-tertiary border border-border-default rounded-xl flex flex-col justify-between h-[230px]">
          <div>
            <h3 class="font-heading font-bold text-xl text-text-primary mb-2">
              Who Would Win?
            </h3>
            <p class="text-text-secondary text-sm mb-4">
              Compare any two anime characters to view head-to-head metrics, power charts, and matchup analysis.
            </p>
          </div>
          <div class="flex gap-3">
            <a href="/comparison" class="btn btn-primary px-5 py-2.5 rounded-lg text-sm shadow-glow-blue flex-grow text-center">
              Open Compare Arena
            </a>
            <a href="/comparison/goku-vs-naruto" class="btn btn-secondary px-5 py-2.5 rounded-lg text-sm text-center">
              View Goku vs Naruto
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Top lists and Blogs Section -->
  <section class="bg-bg-secondary border-t border-border-default py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Top Lists Column (Left 2 cols) -->
        <div class="lg:col-span-2 space-y-6">
          <div>
            <h2 class="section-title">Top Rankings & Lists</h2>
            <p class="text-text-secondary text-sm">Curated rankings of the strongest and most iconic characters</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {topLists.map(list => (
              <div class="card group p-4 bg-bg-primary hover:border-accent-purple transition-all duration-300">
                <div class="aspect-video w-full rounded-lg overflow-hidden mb-3 bg-bg-secondary border border-border-default">
                  <img src={list.image} alt={list.title} class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300" loading="lazy" />
                </div>
                <span class="badge badge-pink mb-2">{list.category}</span>
                <h3 class="font-heading font-bold text-base text-text-primary group-hover:text-accent-purple transition-colors line-clamp-1">
                  <a href={`/list/${list.slug}`}>{list.title}</a>
                </h3>
                <p class="text-xs text-text-secondary line-clamp-2 mt-1 mb-3">{list.description}</p>
                <div class="flex items-center justify-between text-[10px] text-text-tertiary font-semibold uppercase tracking-wider">
                  <span>{list.entries.length} Entries</span>
                  <a href={`/list/${list.slug}`} class="text-accent-purple hover:underline">View List &rarr;</a>
                </div>
              </div>
            ))}
          </div>
          <div class="text-center pt-2">
            <a href="/list" class="text-sm font-bold text-accent-purple hover:underline">
              Browse All Top Lists &rarr;
            </a>
          </div>
        </div>

        <!-- Upgraded Latest Articles Column (Right 1 col) showing featured images -->
        <div class="space-y-6">
          <div>
            <h2 class="section-title">Latest Articles</h2>
            <p class="text-text-secondary text-sm">Guides, opinions, and news from our blog</p>
          </div>

          <div class="space-y-4">
            {recentBlogs.map(post => (
              <div class="card group p-3 bg-bg-primary hover:border-accent-blue hover:shadow-card-hover transition-all duration-300 flex gap-4 items-center">
                <!-- Visual blog cover thumbnail -->
                <div class="w-24 h-16 rounded-lg overflow-hidden bg-bg-secondary border border-border-default flex-shrink-0">
                  <img
                    src={post.featuredImage}
                    alt={post.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
                
                <div class="flex-grow min-w-0">
                  <div class="flex items-center justify-between text-[9px] text-text-tertiary uppercase font-bold tracking-wider">
                    <span>{post.date}</span>
                    <span>{post.readingTime} read</span>
                  </div>
                  <h3 class="font-heading font-bold text-xs text-text-primary hover:text-accent-blue transition-colors line-clamp-1 mt-1">
                    <a href={`/blog/${post.slug}`}>{post.title}</a>
                  </h3>
                  <p class="text-[10px] text-text-secondary line-clamp-1 mt-0.5">{post.excerpt}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="text-center pt-2">
            <a href="/blog" class="text-sm font-bold text-accent-blue hover:underline">
              Visit the Blog &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Bottom Ad Slot -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-8">
    <AdSlot slot="homepage-bottom" format="banner" />
  </div>
</Layout>
