---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import AdSlot from '../../components/AdSlot.astro';
import anime from '../../data/anime.json';
---

<Layout
  title="Anime Series Directory — Browse by Franchise"
  description="Explore the complete list of anime series indexed in our database. View information on studios, ratings, episode counts, and characters for each series."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- Breadcrumb -->
    <Breadcrumb items={[{ label: 'Anime Series' }]} />

    <div class="text-left mb-8">
      <h1 class="text-text-primary text-3xl md:text-5xl font-extrabold tracking-tight leading-none mb-3">
        Anime <span class="gradient-text font-black">Series Catalog</span>
      </h1>
      <p class="text-text-secondary text-sm md:text-base max-w-2xl">
        Browse indexed anime franchises. Select a series to view its detailed synopsis and explore all associated character profiles.
      </p>
    </div>

    <!-- Google Ad Slot Top -->
    <AdSlot slot="anime-directory-top" format="banner" />

    <!-- Grid of Anime Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-8">
      {anime.map(a => (
        <div class="card group bg-bg-secondary border border-border-default rounded-2xl overflow-hidden flex flex-col hover:border-accent-orange hover:shadow-card-hover transition-all duration-300">
          
          <!-- Banner Image with Lazy Load -->
          <div class="relative w-full aspect-[2/1] overflow-hidden bg-bg-primary border-b border-border-default">
            <img
              src={a.image}
              alt={a.title}
              width="1200"
              height="600"
              class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
              loading="lazy"
            />
            
            <!-- Floating Rating Badge -->
            <div class="absolute top-4 right-4 bg-bg-secondary/95 backdrop-blur-sm border border-border-default rounded-xl px-3 py-1 flex items-center gap-1 shadow-md">
              <svg class="w-4 h-4 text-accent-yellow fill-accent-yellow" viewBox="0 0 24 24">
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
              </svg>
              <span class="text-xs font-bold text-text-primary">{a.rating.toFixed(1)}</span>
            </div>

            <!-- Absolute Status Badge -->
            <div class="absolute bottom-4 left-4">
              <span class="badge badge-blue">{a.status}</span>
            </div>
          </div>

          <!-- Description and details -->
          <div class="p-6 flex flex-col flex-grow justify-between">
            <div class="space-y-3">
              <div>
                <h2 class="font-heading text-2xl font-bold text-text-primary group-hover:text-accent-orange transition-colors">
                  <a href={`/anime/${a.slug}`}>{a.title}</a>
                </h2>
                <span class="text-xs text-text-tertiary font-semibold block">{a.japaneseTitle}</span>
              </div>

              <!-- Genres -->
              <div class="flex flex-wrap gap-1.5 pt-1">
                {a.genres.map(g => (
                  <span class="text-[10px] font-bold bg-bg-elevated text-text-secondary px-2.5 py-0.5 rounded-full border border-border-muted uppercase">
                    {g}
                  </span>
                ))}
              </div>

              <p class="text-text-secondary text-sm leading-relaxed line-clamp-4 pt-2">
                {a.synopsis}
              </p>
            </div>

            <!-- Metadata List -->
            <div class="grid grid-cols-3 gap-2 py-4 border-y border-border-muted my-6 text-center text-xs">
              <div>
                <span class="block text-[10px] text-text-tertiary uppercase font-semibold">Studio</span>
                <span class="font-bold text-text-primary truncate">{a.studio}</span>
              </div>
              <div>
                <span class="block text-[10px] text-text-tertiary uppercase font-semibold">Episodes</span>
                <span class="font-bold text-text-primary">{a.episodes}</span>
              </div>
              <div>
                <span class="block text-[10px] text-text-tertiary uppercase font-semibold">Characters</span>
                <span class="font-bold text-accent-orange">{a.characters.length} Indexed</span>
              </div>
            </div>

            <div class="flex items-center justify-between mt-auto">
              <span class="text-xs text-text-tertiary">Aired: {a.aired}</span>
              <a href={`/anime/${a.slug}`} class="btn btn-primary px-4 py-2 text-xs rounded-lg">
                View Characters &rarr;
              </a>
            </div>

          </div>

        </div>
      ))}
    </div>

    <!-- Bottom Ad Slot -->
    <AdSlot slot="anime-directory-bottom" format="banner" />
  </div>
</Layout>
