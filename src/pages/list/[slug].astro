---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SocialShare from '../../components/SocialShare.astro';
import AdSlot from '../../components/AdSlot.astro';
import lists from '../../data/lists.json';
import characters from '../../data/characters.json';

export async function getStaticPaths() {
  return lists.map(item => ({
    params: { slug: item.slug },
    props: { list: item }
  }));
}

const { list } = Astro.props;

// Build list entries with full character objects attached where available
const enrichedEntries = list.entries.map((entry: any) => {
  const char = characters.find(c => c.slug === entry.characterSlug);
  return {
    ...entry,
    character: char ? {
      name: char.name,
      slug: char.slug,
      image: char.image,
      animeName: char.animeName,
      japaneseName: char.japaneseName,
      rating: char.rating
    } : null
  };
});
---

<Layout
  title={list.title}
  description={list.description}
  image={list.image}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- Breadcrumb -->
    <Breadcrumb
      items={[
        { label: 'Rankings', href: '/list' },
        { label: list.title }
      ]}
    />

    <!-- Google Ad Slot Top -->
    <AdSlot slot="list-detail-top" format="banner" />

    <!-- List Header Card -->
    <div class="card p-6 md:p-8 bg-bg-secondary border border-border-default rounded-2xl mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="badge badge-pink">{list.category}</span>
        <span class="badge badge-blue">{list.entries.length} Ranking Entries</span>
      </div>
      
      <h1 class="font-heading text-3xl md:text-5xl font-black text-text-primary leading-tight mb-4">
        {list.title}
      </h1>
      
      <p class="text-text-secondary text-sm md:text-base leading-relaxed mb-6">
        {list.description}
      </p>

      <!-- Social Share -->
      <SocialShare title={list.title} description={list.description} />
    </div>

    <!-- Ad Slot Mid -->
    <AdSlot slot="list-detail-mid" format="auto" />

    <!-- List Entries -->
    <div class="space-y-8 my-8">
      {enrichedEntries.map((entry) => (
        <div class="card p-5 bg-bg-secondary border border-border-default rounded-xl flex flex-col md:flex-row gap-6 relative group hover:border-accent-purple transition-all duration-300">
          
          <!-- Rank Number Tag -->
          <div class="absolute -top-3 -left-3 w-10 h-10 rounded-xl bg-gradient-to-tr from-accent-purple to-accent-pink flex items-center justify-center text-white font-heading font-black text-lg shadow-glow-pink">
            #{entry.rank}
          </div>

          <!-- Character Thumbnail (if found) -->
          {entry.character ? (
            <div class="w-full md:w-[150px] aspect-[2/3] md:aspect-[3/4] rounded-lg overflow-hidden bg-bg-primary border border-border-default flex-shrink-0 relative">
              <img
                src={entry.character.image}
                alt={entry.character.name}
                width="150"
                height="200"
                class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-300"
                loading="lazy"
              />
              <div class="absolute top-2 right-2 bg-bg-secondary/90 backdrop-blur-sm border border-border-default rounded px-1.5 py-0.5 flex items-center gap-0.5">
                <span class="text-[9px] text-accent-yellow font-black">★ {entry.character.rating.toFixed(1)}</span>
              </div>
            </div>
          ) : (
            <div class="w-full md:w-[150px] aspect-[2/3] md:aspect-[3/4] rounded-lg bg-bg-primary border border-dashed border-border-default flex-shrink-0 flex items-center justify-center text-xs text-text-tertiary">
              No Portrait
            </div>
          )}

          <!-- Info & Reason -->
          <div class="flex-grow flex flex-col justify-between py-1">
            <div class="space-y-3">
              <div>
                {entry.character ? (
                  <>
                    <h2 class="font-heading text-xl font-bold text-text-primary group-hover:text-accent-purple transition-colors">
                      <a href={`/character/${entry.character.slug}`}>{entry.character.name}</a>
                    </h2>
                    <span class="text-xs text-text-secondary font-semibold">{entry.character.animeName}</span>
                  </>
                ) : (
                  <h2 class="font-heading text-xl font-bold text-text-primary uppercase tracking-wider">
                    {entry.characterSlug.replace('-', ' ')}
                  </h2>
                )}
              </div>
              
              <p class="text-text-secondary text-sm leading-relaxed">
                {entry.reason}
              </p>
            </div>

            <!-- Action Link (if character exists) -->
            {entry.character && (
              <div class="pt-4 border-t border-border-muted mt-4">
                <a href={`/character/${entry.character.slug}`} class="text-xs text-accent-purple font-bold hover:underline inline-flex items-center gap-1">
                  View Full Profile & Stats &rarr;
                </a>
              </div>
            )}
          </div>

        </div>
      ))}
    </div>

    <!-- Google Ad Slot Bottom -->
    <AdSlot slot="list-detail-bottom" format="banner" />
  </div>
</Layout>
