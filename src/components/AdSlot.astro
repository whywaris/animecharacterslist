---
interface Props {
  slot: string;
  format?: 'auto' | 'fluid' | 'rectangle' | 'banner';
  responsive?: 'true' | 'false';
  className?: string;
}

const { slot, format = 'auto', responsive = 'true', className = '' } = Astro.props;
---

<div class={`ad-slot my-6 mx-auto w-full flex flex-col items-center justify-center ${className}`}>
  <!-- Google AdSense Container -->
  <ins
    class="adsbygoogle"
    style="display:block; text-align:center;"
    data-ad-layout="in-article"
    data-ad-client="ca-pub-placeholder"
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive={responsive}
  ></ins>
  <script>
    // Initialize Google AdSense for this slot
    try {
      ((window as any).adsbygoogle = (window as any).adsbygoogle || []).push({});
    } catch (e) {
      console.warn('AdSense initialization failed', e);
    }
  </script>

  <!-- Premium Dark Placeholder Label (Visible only for preview/developers or when blocked) -->
  <div class="w-full py-2.5 px-4 bg-bg-secondary border border-dashed border-border-default rounded-lg flex items-center justify-between text-[10px] text-text-tertiary uppercase tracking-widest select-none">
    <div class="flex items-center gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full bg-accent-pink/40 animate-pulse"></span>
      ADVERTISEMENT
    </div>
    <div class="font-semibold text-text-tertiary">
      Slot ID: {slot}
    </div>
  </div>
</div>
