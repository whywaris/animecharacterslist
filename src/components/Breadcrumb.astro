---
interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-4 text-xs font-semibold uppercase tracking-wider text-text-tertiary select-none">
  <ol class="flex flex-wrap items-center gap-2">
    <!-- Home -->
    <li>
      <a href="/" class="text-text-secondary hover:text-accent-blue transition-colors flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
        Home
      </a>
    </li>
    
    <!-- Breadcrumb Items -->
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        <!-- Separator -->
        <span class="text-[10px] text-text-tertiary">/</span>
        
        {item.href ? (
          <a href={item.href} class="text-text-secondary hover:text-accent-blue transition-colors">
            {item.label}
          </a>
        ) : (
          <span class="text-text-primary truncate max-w-[200px]" aria-current="page">
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
