---
const currentYear = new Date().getFullYear();
---

<footer class="bg-bg-secondary border-t border-border-default mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Logo and Description -->
      <div class="space-y-4 col-span-1 md:col-span-1">
        <a href="/" class="flex items-center gap-2 font-heading font-extrabold text-lg tracking-tight text-text-primary">
          <span class="w-7 h-7 rounded-lg bg-gradient-to-tr from-accent-blue to-accent-pink flex items-center justify-center text-white text-sm shadow-glow-blue">
            A
          </span>
          <span class="gradient-text font-black">AnimeCharactersList</span>
        </a>
        <p class="text-text-secondary text-sm">
          Your ultimate repository for anime character metrics, detailed power stats, profiles, comparisons, quizzes, and ranking lists.
        </p>
        <div class="flex space-x-4 pt-2">
          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-blue transition-colors">
            <span class="sr-only">Twitter</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-blue transition-colors">
            <span class="sr-only">Facebook</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
            </svg>
          </a>
          <a href="https://reddit.com" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-blue transition-colors">
            <span class="sr-only">Reddit</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 5.011 3.7 9.155 8.547 9.878v-6.987h-2.5v-2.89h2.5v-2.203c0-2.508 1.492-3.891 3.777-3.891 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.3 21.155 22 17.011 22 12c0-5.523-4.477-10-10-10z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div class="col-span-1">
        <h3 class="font-heading font-bold text-sm tracking-wider uppercase text-text-primary mb-4">
          Directory
        </h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/characters" class="text-text-secondary hover:text-accent-blue transition-colors">Character Catalog</a></li>
          <li><a href="/anime" class="text-text-secondary hover:text-accent-blue transition-colors">Anime Series</a></li>
          <li><a href="/list" class="text-text-secondary hover:text-accent-blue transition-colors">Rankings & Lists</a></li>
          <li><a href="/comparison" class="text-text-secondary hover:text-accent-blue transition-colors">Compare Matchups</a></li>
          <li><a href="/quiz" class="text-text-secondary hover:text-accent-blue transition-colors">Personality Quizzes</a></li>
        </ul>
      </div>

      <!-- Legal and Support -->
      <div class="col-span-1">
        <h3 class="font-heading font-bold text-sm tracking-wider uppercase text-text-primary mb-4">
          Company
        </h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/about" class="text-text-secondary hover:text-accent-blue transition-colors">About Us</a></li>
          <li><a href="/contact" class="text-text-secondary hover:text-accent-blue transition-colors">Contact</a></li>
          <li><a href="/privacy" class="text-text-secondary hover:text-accent-blue transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-text-secondary hover:text-accent-blue transition-colors">Terms of Service</a></li>
          <li><a href="/admin" class="text-text-secondary hover:text-accent-pink transition-colors font-semibold">Admin Panel</a></li>
        </ul>
      </div>

      <!-- Newsletter Signup -->
      <div class="col-span-1 space-y-4">
        <h3 class="font-heading font-bold text-sm tracking-wider uppercase text-text-primary mb-4">
          Subscribe
        </h3>
        <p class="text-text-secondary text-sm">
          Get weekly character statistics, top lists, and quiz updates delivered straight to your inbox.
        </p>

        <!-- Mailchimp Embed Form -->
        <div id="mc_embed_signup">
          <form
            action="https://animecharacterslist.us21.list-manage.com/subscribe/post?u=placeholder_u&id=placeholder_id"
            method="post"
            id="mc-embedded-subscribe-form"
            name="mc-embedded-subscribe-form"
            class="validate flex flex-col gap-2"
            target="_blank"
            novalidate
          >
            <div class="flex gap-2">
              <input
                type="email"
                name="EMAIL"
                class="required email bg-bg-primary border border-border-default rounded-md px-3 py-2 text-sm text-text-primary w-full focus:outline-none focus:border-accent-blue placeholder-text-tertiary"
                id="mce-EMAIL"
                placeholder="Enter your email"
                required
                loading="lazy"
              />
              <button
                type="submit"
                name="subscribe"
                id="mc-embedded-subscribe"
                class="btn btn-primary px-4 py-2 rounded-md text-sm font-semibold"
              >
                Join
              </button>
            </div>
            <!-- bot prevention -->
            <div style="position: absolute; left: -5000px;" aria-hidden="true">
              <input type="text" name="b_placeholder_u_placeholder_id" tabindex="-1" value="" />
            </div>
          </form>
        </div>

      </div>

    </div>

    <!-- Copyright and AdSense warning -->
    <div class="border-t border-border-muted mt-12 pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-text-tertiary">
      <div>
        &copy; {currentYear} AnimeCharactersList.com. All rights reserved.
      </div>
      <div>
        Disclaimer: This site is a fan directory. All characters and franchise images belong to their respective creators and animation studios.
      </div>
    </div>
  </div>
</footer>
